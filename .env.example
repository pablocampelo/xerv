# Browser-safe. Set at build time; rebuild after changes. HTTPS except loopback.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
# Use the project's sb_publishable_ key, never a service-role or sb_secret_ key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Replace with your support inbox before publication.
SUPPORT_EMAIL=support@example.com

# Required for server-owned billing writes (webhooks/reconciliation). Never expose this key to the browser.
# Hosted projects should use an sb_secret_ key. Local Supabase may use the legacy service-role JWT printed by the CLI.
SUPABASE_SECRET_KEY=

# Stripe Billing. Keep staging/test and production/live credentials strictly separated.
# Price IDs select the only purchasable plans; Stripe Price remains authoritative for amount/currency/recurrence.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Configure Google OAuth and Resend SMTP in Supabase, not in browser-visible variables.
# Provider setup: docs/SETUP.md
